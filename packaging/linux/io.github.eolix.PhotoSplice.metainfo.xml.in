<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>io.github.eolix.PhotoSplice</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>PhotoSplice</name>
  <summary>Edit photos and layered PSD documents</summary>
  <developer id="io.github.eolix">
    <name>The PhotoSplice authors</name>
  </developer>
  <description>
    <p>
      PhotoSplice is an open-source, native image editor with the familiar menus,
      shortcuts, panels and tools professionals expect: layers, masks, adjustment
      layers, layer styles, type and brushes.
    </p>
    <ul>
      <li>Open, edit and save layered PSD and PSB files</li>
      <li>8-bit, 16-bit and 32-bit float documents in RGB, grayscale, CMYK and Lab</li>
      <li>A GPU compositor with multithreaded filters</li>
      <li>Every action is a command, scriptable from a JSON control channel</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.eolix.PhotoSplice.desktop</launchable>
  <icon type="stock">io.github.eolix.PhotoSplice</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser.
       The same addresses as Help › Website / GitHub / Report Issue (crates/ui-egui/src/links.rs). -->
  <url type="homepage">https://photosplice.com</url>
  <url type="bugtracker">https://github.com/eolix/photosplice/issues</url>
  <url type="help">https://github.com/eolix/photosplice</url>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>image editor</keyword>
    <keyword>psd</keyword>
    <keyword>layers</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <!-- The Tauri build's id: software centres show this app as its successor. -->
  <replaces>
    <id>app.photosplice.PhotoSplice</id>
  </replaces>
  <provides>
    <binary>photosplice</binary>
    <mediatype>application/x-photosplice</mediatype>
    <mediatype>image/x-paintnet</mediatype>
    <mediatype>image/openraster</mediatype>
    <mediatype>application/x-krita</mediatype>
    <mediatype>image/vnd.adobe.photoshop</mediatype>
    <mediatype>image/x-psb</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
